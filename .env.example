# Telegram Bot Token (@BotFather'dan alınan token)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Chat ID (mesajların gönderileceği sohbet)
TELEGRAM_CHAT_ID=-1001234567890

# Virgülle ayrılmış AVESİS profil URL'leri.
# Bu yalnızca ilk çalıştırmadaki başlangıç listesidir; sonrasında takip listesi
# /seç komutuyla yönetilir ve data/tracked.json dosyasında tutulur.
PROFESSORS=https://avesis.yildiz.edu.tr/johndoe,https://avesis.yildiz.edu.tr/janedoe

# Günlük kontrol saati (HH:MM formatında)
CHECK_TIME=09:00

# ── /seç komutu: eklenebilecek hocaların kapsamı ─────────────────────────────
# Hoca ekleme listesi bu kurumun bu fakültesiyle sınırlanır.
AVESIS_BASE_URL=https://avesis.yildiz.edu.tr
FACULTY_NAME=Elektrik-Elektronik Fakültesi

# Fakülte kadro listesinin önbellek ömrü (saat)
FACULTY_CACHE_TTL_HOURS=24
